// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  city          String   @db.VarChar(50)
  country       String   @db.VarChar(50)
  zipCode       String   @db.VarChar(9)
  street        String   @db.VarChar(100)
  complement    String?  @db.VarChar(50)
  neighborhood  String   @db.VarChar(50)
  state         String   @db.VarChar(50)
  numberAddress String   @db.VarChar(10)
  phone         String   @db.VarChar(15)
  cpf           String   @db.VarChar(15)
  cnpj          String?  @db.VarChar(18)
  firstName     String   @db.VarChar(50)
  lastName      String   @db.VarChar(50)
  email         String   @unique @db.VarChar(254)
  password      String
  role          Role     @default(USER)
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updateAt      DateTime @updatedAt
  cars          Car[]    @relation("Seller")
  purchaser     Order[]  @relation("Purchaser")
  seller        Order[]  @relation("Seller")
}

enum Role {
  USER
  SELLER
}

model Car {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(50)
  price       Decimal @db.Decimal(12, 4)
  model       String  @db.VarChar(30)
  color       String  @db.VarChar(30)
  year        Int     @db.SmallInt
  description String  @db.VarChar(300)
  sellerId    String
  seller      User    @relation("Seller", fields: [sellerId], references: [id])
  order       Order[]
}

model Order {
  id            String   @id @default(uuid())
  totalValue    Decimal  @db.Decimal(12, 4)
  methodPayment String   @db.VarChar(30)
  status        Status   @default(CREATED)
  sellerId      String
  purchaserId   String
  carId         String
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  seller        User     @relation("Seller", fields: [sellerId], references: [id])
  purchaser     User     @relation("Purchaser", fields: [purchaserId], references: [id])
  car           Car      @relation(fields: [carId], references: [id])
}

enum Status {
  CREATED
  CANCELED
  FINISHED
}
