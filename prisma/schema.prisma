// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  city           String   @db.VarChar(50)
  country        String   @db.VarChar(50)
  zip_code       String   @db.VarChar(9)
  street         String   @db.VarChar(100)
  complement     String?  @db.VarChar(50)
  neighborhood   String   @db.VarChar(50)
  state          String   @db.VarChar(50)
  number_address String   @db.VarChar(10)
  phone          String   @db.VarChar(15)
  cpf            String   @db.VarChar(15)
  cnpj           String?  @db.VarChar(18)
  first_name     String   @db.VarChar(50)
  last_name      String   @db.VarChar(50)
  email          String   @unique @db.VarChar(254)
  password       String
  role           Role     @default(USER)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  update_at      DateTime @updatedAt
  cars           Car[]    @relation("Seller")
  purchaser      Order[]  @relation("Purchaser")
  seller         Order[]  @relation("Seller")

  @@map("user")
}

model Car {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(50)
  price       Decimal @db.Decimal(12, 2)
  model       String  @db.VarChar(30)
  color       String  @db.VarChar(30)
  year        Int     @db.SmallInt
  description String  @db.VarChar(300)
  stock       Int     @default(1)
  seller_id   String
  seller      User    @relation("Seller", fields: [seller_id], references: [id])
  order       Order[]

  @@map("car")
}

model Order {
  id             String        @id @default(uuid())
  order_number   Int           @default(autoincrement())
  total_value    Decimal       @db.Decimal(12, 2)
  payment_method PaymentMethod
  status         Status        @default(CREATED)
  seller_id      String
  purchaser_id   String
  car_id         String
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  seller         User          @relation("Seller", fields: [seller_id], references: [id])
  purchaser      User          @relation("Purchaser", fields: [purchaser_id], references: [id])
  car            Car           @relation(fields: [car_id], references: [id])

  @@map("order")
}

enum Role {
  USER
  SELLER
}

enum PaymentMethod {
  CREDIT
  DEBIT
  PIX
}

enum Status {
  CREATED
  CANCELED
  FINISHED
}
